{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "smart-pim",
  "mainBinaryName": "smart-pim",
  "version": "0.0.2",
  "identifier": "io.smartpim.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Smart PIM",
        "width": 1280,
        "height": 800,
        "minWidth": 940,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/share/mime/packages/smart-pim.xml": "resources/smart-pim-mime.xml"
        },
        "desktopTemplate": "resources/smart-pim.desktop.tmpl"
      }
    }
  }
}
